<?xml version="1.0"?>
<package format="3">
  <name>pickcell_test_support</name>
  <version>0.1.0</version>
  <description>Reusable synthetic fixtures and contract assertions for PickCell ROS 2 tests.</description>
  <maintainer email="mahdi@example.com">Mahdi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>pickcell_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
