<?xml version="1.0"?>
<package format="3">
  <name>pickcell_bringup</name>
  <version>0.1.0</version>
  <description>Launch nodes from the PickCell application YAML file.</description>
  <maintainer email="mahdi@example.com">Mahdi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>pickcell_config</exec_depend>
  <exec_depend>pickcell_description</exec_depend>
  <exec_depend>pickcell_mock_nodes</exec_depend>
  <exec_depend>pickcell_motion_server</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
