<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pickcell_bag_pallet">
  <xacro:include filename="$(find pickcell_description)/urdf/bag_pallet.xacro"/>

  <!-- The robot description owns world -> cell; this model starts at cell so
       its state publisher only owns pallet and bag transforms. -->
  <link name="cell"/>
  <xacro:bag_pallet parent="cell"/>
</robot>
