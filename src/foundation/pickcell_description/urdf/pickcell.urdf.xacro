<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pickcell">
  <!--
    Cell description configured for a KUKA KR 180 R2900-2. The maintained
    KR 240 R2900-2 ROS model is used as a temporary same-family, same-reach
    geometry proxy until an exact KR 180 mesh package is available.
  -->
  <xacro:include filename="$(find kuka_quantec_support)/urdf/kr240_r2900_2_macro.xacro"/>
  <xacro:include filename="$(find pickcell_description)/urdf/bag_pallet.xacro"/>
  <xacro:include filename="$(find pickcell_description)/urdf/drop_box.xacro"/>
  <xacro:include filename="$(find pickcell_description)/urdf/simple_gripper.xacro"/>

  <xacro:arg name="robot_prefix" default=""/>
  <xacro:arg name="robot_mount_xyz" default="0 0 0"/>
  <xacro:arg name="robot_mount_rpy" default="0 0 0"/>
  <xacro:arg name="tcp_xyz" default="0 0 0"/>
  <xacro:arg name="tcp_rpy" default="0 0 0"/>
  <xacro:arg name="include_pallet" default="true"/>
  <xacro:arg name="include_drop_box" default="true"/>
  <xacro:property name="prefix" value="$(arg robot_prefix)"/>

  <link name="world"/>
  <link name="cell"/>
  <joint name="world_to_cell" type="fixed">
    <parent link="world"/>
    <child link="cell"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- robot_base is the configurable mounting pose inside the cell. -->
  <link name="robot_base"/>
  <joint name="cell_to_robot_base" type="fixed">
    <parent link="cell"/>
    <child link="robot_base"/>
    <origin xyz="$(arg robot_mount_xyz)" rpy="$(arg robot_mount_rpy)"/>
  </joint>

  <!-- Kept in the complete model for MoveIt collision checking, but omitted
       from the robot-only description consumed by RViz. -->
  <xacro:if value="$(arg include_pallet)">
    <xacro:bag_pallet parent="cell"/>
  </xacro:if>
  <xacro:if value="$(arg include_drop_box)">
    <xacro:drop_box parent="cell"/>
  </xacro:if>

  <xacro:kuka_kr240_r2900_2_robot
    prefix="${prefix}"
    package_name="kuka_quantec_support"/>

  <joint name="robot_base_to_kuka_base_link" type="fixed">
    <parent link="robot_base"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:simple_gripper parent="${prefix}tool0"
    tcp_xyz="$(arg tcp_xyz)" tcp_rpy="$(arg tcp_rpy)"/>

  <!-- Fixed overhead depth camera. Its optical +Z axis points straight down
       at the pallet centre, matching the ROS optical-frame convention. -->
  <link name="overhead_depth_camera_link"/>
  <joint name="cell_to_overhead_depth_camera" type="fixed">
    <parent link="cell"/>
    <child link="overhead_depth_camera_link"/>
    <origin xyz="1.4 0 2.0" rpy="0 1.57079632679 0"/>
  </joint>

  <link name="overhead_depth_camera_optical_frame"/>
  <joint name="overhead_depth_camera_to_optical" type="fixed">
    <parent link="overhead_depth_camera_link"/>
    <child link="overhead_depth_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

</robot>
